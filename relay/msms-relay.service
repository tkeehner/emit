[Unit]
Description=Matrix SMS relay (ciphertext-only splice, TLS :443)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=msms-relay
Group=msms-relay
ExecStart=/usr/bin/python3 -I /opt/msms-relay/msms_relay.py --config /etc/msms-relay/relay.json --cert /etc/msms-relay/cert.pem --key /etc/msms-relay/key.pem
Restart=always
RestartSec=3
# Only privilege: bind :443
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
UMask=0077
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
ReadOnlyPaths=/etc/msms-relay
InaccessiblePaths=-/etc/msms-relay/client.json
# Debug dump (off by default) writes only here; see README
StateDirectory=msms-relay
StateDirectoryMode=0700
LimitNOFILE=4096
MemoryMax=256M
TasksMax=64
# stdout carries only startup lines; payloads are never logged
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
